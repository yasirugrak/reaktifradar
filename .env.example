APP_NAME=ReaktifRadar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://reaktifradar.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
DB_CONNECTION=pgsql
DB_HOST=okukid-postgres
DB_PORT=5432
DB_DATABASE=reaktifradar
DB_USERNAME=reaktifradar
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=reaktifradar_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ReaktifRadar
ENERJISA_DEBUG=false
# Gerekirse eski merkezi botun ortam ayarlarını buraya taşıyın.
ENERJISA_TELEGRAM_BOT_TOKEN=
ENERJISA_TELEGRAM_BOT_USERNAME=
ENERJISA_TELEGRAM_WEBHOOK_SECRET=
REAKTIFRADAR_NOTIFICATIONS_ENABLED=false
# Temporary read-only source access for import. Remove after verified cutover.
LEGACY_DB_HOST=okukid-postgres
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=okukid
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_APP_KEY=
LEGACY_APP_PREVIOUS_KEYS=

# Mevcut OkuKid compose ağları; PostgreSQL/Redis servisi oluşturulmaz.
SHARED_NETWORK=yasir_net
OKUKID_INTERNAL_NETWORK=okukid_internal
APP_UID=1000
APP_GID=1000
# Redis 8 ve 9 yalnızca ReaktifRadar için ayrılmalı.
REAKTIFRADAR_REDIS_DB=8
REAKTIFRADAR_REDIS_CACHE_DB=9
REDIS_CLIENT=predis
REDIS_HOST=okukid-redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=8
REDIS_CACHE_DB=9
REDIS_PREFIX=reaktifradar:
CACHE_PREFIX=reaktifradar:cache:

# Ana sayfada gösterilecek hizmet iletişim bilgileri.
CONTACT_EMAIL=info@reaktifradar.com
CONTACT_PHONE=
